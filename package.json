{
  "name": "67-millions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build --mode yandex",
    "build:pages": "tsc --noEmit && vite build --mode pages --base /67-millions/",
    "smoke:pages": "node --import tsx tools/pages-smoke.mjs",
    "build:yandex:debug": "tsc --noEmit && vite build --mode yandex-debug",
    "preview": "vite preview",
    "release:check": "npm run build && node tools/yandex-audit.mjs",
    "simulate:plinko": "tsx simulation/plinko/cli.ts",
    "simulate:plinko:sweep": "tsx simulation/plinko/sweep.ts",
    "build:perf": "tsc --noEmit && vite build --mode performance",
    "perf:plinko": "node tools/plinko-perf-smoke.mjs",
    "simulate:plinko:milestone": "tsx simulation/plinko/cli.ts",
    "simulate:plinko:pin-layout": "tsx simulation/plinko/pinLayoutProbe.ts",
    "simulate:plinko:cascade": "tsx simulation/plinko/cascadeCli.ts",
    "simulate:plinko:return-sweep": "tsx simulation/plinko/returnSweep.ts",
    "simulate:plinko:pocket-entry-sweep": "tsx simulation/plinko/pocketEntrySweep.ts",
    "simulate:plinko:jackpot-bias": "tsx simulation/plinko/jackpotBiasSweep.ts",
    "simulate:plinko:jackpot-bias-probe": "tsx simulation/plinko/jackpotBiasProbe.ts",
    "simulate:full-game": "tsx simulation/full-game/cli.ts",
    "simulate:full-game:report": "tsx simulation/full-game/reportCli.ts",
    "smoke:release": "node --import tsx tools/release-smoke.mjs",
    "art:build": "node tools/build-art.mjs",
    "balance:search": "tsx tools/balance-search.ts",
    "soak:plinko": "node --import tsx tools/plinko-soak.mjs",
    "release:package": "npm run release:check && node tools/package-candidate.mjs"
  },
  "dependencies": {
    "@danilah/mini-games-kit": "github:DanilaH/mini-games-kit#43913152e5b409cdb84515eabb69166f6caaa8bb",
    "phaser": "4.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/matter-js": "0.20.2",
    "@types/node": "26.4.1",
    "matter-js": "0.20.0",
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
